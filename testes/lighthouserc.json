{
  "ci": {
    "collect": {
      "startServerCommand": "node servidor.mjs",
      "startServerReadyPattern": "rodando",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/orcamento.html",
        "http://localhost:4173/modelos/barbearia/index.html",
        "http://localhost:4173/modelos/consultoria/index.html",
        "http://localhost:4173/modelos/petshop/index.html",
        "http://localhost:4173/modelos/barbearia-completo/servicos.html",
        "http://localhost:4173/modelos/consultoria-completo/servicos.html",
        "http://localhost:4173/modelos/petshop-completo/banho-e-tosa.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": [
          "is-crawlable"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./relatorios-lighthouse"
    }
  }
}
